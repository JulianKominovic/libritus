{
  "name": "libritus",
  "version": "0.2.0",
  "description": "Research workspace with an infinite PDF canvas.",
  "main": "./out/main/index.js",
  "author": "Julian Kominovic",
  "license": "CC-BY-NC-SA-4.0",
  "homepage": "https://github.com/JulianKominovic/libritus",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps && mkdir -p src/renderer/public && rm -rf src/renderer/public/fonts && mkdir -p src/renderer/public/fonts && for f in Assistant Cascadia ComicShanns Excalifont Liberation Lilita Nunito Virgil; do cp -R \"node_modules/@excalidraw/excalidraw/dist/prod/fonts/$f\" src/renderer/public/fonts/; done",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:mac": "npm run build && electron-builder --mac --arm64",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:all": "npm run build && electron-builder --win --x64 --mac --arm64 --linux",
    "release": "npm run build && electron-builder --win --x64 --mac --arm64 --linux --publish always",
    "test": "bun test src",
    "test:watch": "bun test --watch src",
    "test:e2e": "electron-vite build && playwright test -c e2e/playwright.config.ts",
    "test:all": "bun run test && bun run test:e2e"
  },
